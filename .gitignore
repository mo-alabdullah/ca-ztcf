# --- secrets and generated credentials (never committed) ---
secrets/
*.pem
*.key
*.p12
*.pfx
.env
.env.*

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- runtime output ---
*.log
logs/
audit/
artifacts/**/*.jsonl
!artifacts/**/.gitkeep

# Per-run audit logs written by the experiment runner; the raw JSONL under
# results/dev/raw/ is the committed evidence, not these working copies.
results/dev/audit/

# --- os ---
.DS_Store

# --- tier-1 wlan generated key material (never commit) ---
testbed/wlan/certs/
artifacts/tier1-wlan/

# --- tier-2 generated key material and captures (never commit) ---
testbed/tier2/certs/
artifacts/tier2/
results/invalidated/
